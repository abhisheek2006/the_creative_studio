{
  "name": "the-creative-studio",
  "version": "1.0.0",
  "private": true,
  "description": "The Creative Studio (TCS) - handmade gifts, paintings, flowers, printing & islander recruitment. React + Vite storefront with an Express/MongoDB backend, deployable on Vercel.",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon server/src/server.js",
    "start": "node server/src/server.js",
    "server": "node server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "install:client": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/src/seed/seed.js",
    "create-admin": "node server/scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.24",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7"
  }
}
