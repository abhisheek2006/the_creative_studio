# ============================================================
# The Creative Studio — Environment Variables (EXAMPLE ONLY)
# Copy this file to `.env` (root) and fill in real values.
# NEVER commit your real .env file.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (use a restricted DB user)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/the_creative_studio?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
# Cookies: 'lax' for same-site (localhost), 'none' for cross-site prod (requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Business (safe to expose publicly via /api/settings/public)
WHATSAPP_NUMBER=919679573542
INSTAGRAM_URL=https://www.instagram.com/the_creativestudio26/
CURRENCY=INR

# Cloudflare R2 (image storage, S3-compatible). Leave blank to use local-dev disk fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tcs-product-images
# Endpoint is derived from R2_ACCOUNT_ID if left blank:
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public base URL for uploaded objects (r2.dev dev URL or a custom domain).
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# Image upload limits
MAX_IMAGE_MB=5

# One-time admin bootstrap (used by `npm run seed` / `npm run create-admin`)
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@thecreativestudio.example
ADMIN_INITIAL_PASSWORD=ChangeThisImmediately123!

# ---- Firebase / Google auth ----
# Server SDK service account (SECRET). Create from Firebase console →
# Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes on a single line.
FIREBASE_PRIVATE_KEY=""

# Browser (public) Firebase web config — Firebase console →
# Project settings → Your apps → Web app (SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public API base used by the client build (leave blank to use same-origin /api)
# VITE_API_URL=/api

# Public site URL used for canonical links, Open Graph tags and JSON-LD (recommended in production)
# VITE_SITE_URL=https://your-domain.com
